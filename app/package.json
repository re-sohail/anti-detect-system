{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "description": "LVD Research control app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-clean.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/run-clean.mjs electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --no-warnings --test test/*.test.ts",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "package": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@lvd/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
