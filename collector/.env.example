# Required in production. Dev falls back to "dev-admin-key".
COLLECTOR_ADMIN_KEY=
# Where the append-only SQLite store lives (default: ./.data)
COLLECTOR_DATA_DIR=
# Comma-separated IPs of reverse proxies we operate; only their X-Forwarded-For is trusted.
# Leave empty when clients connect directly.
TRUSTED_PROXIES=
PORT=4100
