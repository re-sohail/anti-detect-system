    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lvd/shared": "*",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  }
